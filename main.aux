\@writefile{lof}{\setforeignlanguage {serbian}}
\@writefile{lot}{\setforeignlanguage {serbian}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Детаљна архитектура и ток података Diffusion Policy примењене у овом раду. Слике три камере и проприоцептивно стање (за $n_{\mathrm  {obs}}=2$ корака) кодирају се дељеним ResNet-18 backbone-ом са просторним softmax-ом (32 тачке) у условни вектор $\mathbf  {O}_t$. Мрежа за одшумљавање ($1$D U-Net $\boldsymbol  {\epsilon }_\theta $) условљена је FiLM модулацијом из $\mathbf  {O}_t$ и синусоидном векторском репрезентацијом корака дифузије $t$, и предвиђа шум $\hat  {\boldsymbol  {\epsilon }}$ додат на зашумљену акцијску секвенцу $\mathbf  {a}_t$. У обуци се минимизује средња квадратна грешка предвиђеног шума уз помоћни губитак фазе; у примени се поступак понавља $100$ пута (DDPM) да би се из чистог шума генерисала секвенца од $T_p=16$ акција, од којих се извршава првих $T_a=8$ (рецедирајући хоризонт).}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:dp_arh}{{5}{11}{Детаљна архитектура и ток података Diffusion Policy примењене у овом раду. Слике три камере и проприоцептивно стање (за $n_{\mathrm {obs}}=2$ корака) кодирају се дељеним ResNet-18 backbone-ом са просторним softmax-ом (32 тачке) у условни вектор $\mathbf {O}_t$. Мрежа за одшумљавање ($1$D U-Net $\boldsymbol {\epsilon }_\theta $) условљена је FiLM модулацијом из $\mathbf {O}_t$ и синусоидном векторском репрезентацијом корака дифузије $t$, и предвиђа шум $\hat {\boldsymbol {\epsilon }}$ додат на зашумљену акцијску секвенцу $\mathbf {a}_t$. У обуци се минимизује средња квадратна грешка предвиђеног шума уз помоћни губитак фазе; у примени се поступак понавља $100$ пута (DDPM) да би се из чистог шума генерисала секвенца од $T_p=16$ акција, од којих се извршава првих $T_a=8$ (рецедирајући хоризонт)}{figure.caption.5}{}}
